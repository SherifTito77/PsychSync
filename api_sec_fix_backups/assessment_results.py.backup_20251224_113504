def select_random_questions(questions, num_questions=30):
    """
    Select a random subset of questions while ensuring balanced coverage
    """
    if len(questions) <= num_questions:
        return questions

    # Determine the categorization field based on assessment type
    category_field = None
    if questions and "dimension" in questions[0]:
        category_field = "dimension"  # MBTI, Leadership
    elif questions and "trait" in questions[0]:
        category_field = "trait"      # Big Five
    elif questions and "type" in questions[0]:
        category_field = "type"       # Enneagram, Holland Codes
    elif questions and "factor" in questions[0]:
        category_field = "factor"     # Predictive Index
    elif questions and "competency" in questions[0]:
        category_field = "competency" # Emotional Intelligence
    elif questions and "theme" in questions[0]:
        category_field = "theme"      # StrengthsFinder
    elif questions and "style" in questions[0]:
        category_field = "style"      # Social Styles

    # If we have a categorization field, try to balance across categories
    if category_field:
        # Group by category
        by_category = {}
        for q in questions:
            category = q.get(category_field, "unknown")
            if category not in by_category:
                by_category[category] = []
            by_category[category].append(q)

        # Select proportional questions from each category
        selected = []
        questions_per_category = max(1, num_questions // len(by_category))

        for category, category_questions in by_category.items():
            if len(selected) + questions_per_category <= num_questions:
                selected.extend(secrets.SystemRandom().sample(category_questions, min(questions_per_category, len(category_questions))))
            else:
                remaining = num_questions - len(selected)
                selected.extend(secrets.SystemRandom().sample(category_questions, min(remaining, len(category_questions))))
                break

        # If we still need more questions, add randomly
        while len(selected) < num_questions:
            remaining_questions = [q for q in questions if q not in selected]
            if remaining_questions:
                selected.append(secrets.choice(remaining_questions))
            else:
                break

        # Shuffle the final selection
        secrets.SystemRandom().shuffle(selected)
        return selected[:num_questions]

    else:
        # Simple random selection for assessments without clear categories
        return secrets.SystemRandom().sample(questions, num_questions)

