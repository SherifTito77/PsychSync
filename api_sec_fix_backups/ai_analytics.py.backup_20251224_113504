@router.get("/insights")
async def get_ai_insights(
    organization_id: Optional[str] = Query(None, description="Organization ID filter"),
    team_id: Optional[str] = Query(None, description="Team ID filter"),
    insight_type: Optional[str] = Query(None, description="Filter by insight type"),
    priority: Optional[str] = Query(None, description="Filter by priority level"),
    limit: int = Query(20, ge=1, le=100, description="Maximum number of insights"),
    current_user: User = Depends(get_current_active_user),
    db: AsyncSession = Depends(get_db)
):
    """
    Get AI-generated insights with filtering options

    - **insight_type**: Filter by prediction, anomaly_detection, trend_analysis, recommendation, risk_assessment, opportunity_identification
    - **priority**: Filter by critical, high, medium, low
    - **limit**: Maximum number of insights to return (1-100)
    """
    try:
        ai_analytics = AIEnhancedAnalyticsService(db)

        # Get full dashboard data to extract insights
        dashboard_data = await ai_analytics.get_ai_enhanced_dashboard(
            organization_id=organization_id,
            team_id=team_id,
            time_period_days=30
        )

        insights = dashboard_data.get("ai_insights", {}).get("insights", [])

        # Apply filters
        if insight_type:
            insights = [i for i in insights if i.get("type") == insight_type]

        if priority:
            insights = [i for i in insights if i.get("priority") == priority]

        # Limit results
        insights = insights[:limit]

        return {
            "success": True,
            "data": {
                "insights": insights,
                "total_count": len(insights),
                "filters_applied": {
                    "insight_type": insight_type,
                    "priority": priority,
                    "limit": limit
                }
            }
        }

    except Exception as e:
        logger.error(f"Error getting AI insights: {e}")

