{
  "advanced_question_types": [
    {
      "type": "time_based_pattern",
      "description": "Questions about daily/weekly patterns and timing",
      "example": {
        "id": "daily_energy_curve",
        "text": "How does your energy level change throughout a typical day?",
        "ui": "energy_curve_slider",
        "time_points": ["Wake up", "Mid-morning", "Lunch", "Afternoon", "Evening", "Bedtime"],
        "scale": ["Very Low", "Low", "Moderate", "High", "Very High"]
      }
    },
    {
      "type": "priority_ranking",
      "description": "Drag-and-drop ranking of priorities",
      "example": {
        "id": "wellness_priorities",
        "text": "Rank these wellness areas from most to least important to you right now",
        "items": ["Better sleep", "More energy", "Less stress", "Healthier eating", "Regular exercise", "Social connection"],
        "ui": "draggable_ranking"
      }
    },
    {
      "type": "scenario_simulation",
      "description": "Choose actions in realistic scenarios",
      "example": {
        "id": "stress_scenario",
        "text": "It's 2 PM and you have a deadline, but you're exhausted. What do you do?",
        "scenario": {
          "context": "Work deadline approaching, feeling drained",
          "options": [
            {"text": "Power through with coffee", "outcome": "short_term_energy"},
            {"text": "Take a 15-minute walk", "outcome": "moderate_recovery"},
            {"text": "Postpone and rest", "outcome": "long_term_health"},
            {"text": "Ask for help", "outcome": "collaborative_solution"}
          ]
        }
      }
    },
    {
      "type": "habit_tracking",
      "description": "Track specific behaviors over time",
      "example": {
        "id": "hydration_habits",
        "text": "Show us your typical water intake throughout the day",
        "ui": "timeline_tracker",
        "time_slots": ["Morning", "Mid-morning", "Noon", "Afternoon", "Evening"],
        "metric": "glasses of water",
        "target": 8
      }
    },
    {
      "type": "environmental_assessment",
      "description": "Assess impact of physical environment",
      "example": {
        "id": "sleep_environment",
        "text": "How would you describe your sleeping environment?",
        "environment_factors": [
          {
            "factor": "Light levels",
            "options": ["Very dark", "Dimly lit", "Moderate light", "Bright light", "Variable light"]
          },
          {
            "factor": "Noise levels",
            "options": ["Completely quiet", "Mostly quiet", "Some noise", "Frequent noise", "Very noisy"]
          },
          {
            "factor": "Temperature",
            "options": ["Too cold", "Cool", "Comfortable", "Warm", "Too hot"]
          },
          {
            "factor": "Comfort",
            "options": ["Very uncomfortable", "Somewhat uncomfortable", "Neutral", "Comfortable", "Very comfortable"]
          }
        ]
      }
    },
    {
      "type": "social_network_analysis",
      "description": "Map social support and influence",
      "example": {
        "id": "wellness_circle",
        "text": "Who supports your wellness journey?",
        "network_map": {
          "categories": [
            {"name": "Close supporters", "max_people": 5, "description": "People you can count on"},
            {"name": "Occasional supporters", "max_people": 10, "description": "Friends who help sometimes"},
            {"name": "Professional support", "max_people": 3, "description": "Healthcare providers, trainers, etc."},
            {"name": "Wellness influencers", "max_people": 5, "description": "People who inspire healthy habits"}
          ]
        }
      }
    }
  ],

  "additional_domains": [
    {
      "domain": "Environmental Wellness",
      "description": "Impact of physical and social environments on wellbeing",
      "focus_areas": [
        "Living space quality",
        "Work environment",
        "Neighborhood safety and amenities",
        "Exposure to nature",
        "Environmental sustainability practices"
      ],
      "key_questions": [
        {
          "id": "home_environment",
          "text": "How does your home environment affect your wellbeing?",
          "aspects": ["Air quality", "Natural light", "Noise levels", "Organization/cleanliness", "Comfort", "Safety"]
        },
        {
          "id": "work_space",
          "text": "Rate your workspace on these wellness factors",
          "factors": ["Ergonomics", "Lighting", "Air quality", "Noise control", "Privacy", "Break areas"]
        }
      ]
    },
    {
      "domain": "Financial Wellness",
      "description": "Financial health and its relationship to overall wellbeing",
      "focus_areas": [
        "Financial stress and anxiety",
        "Budgeting and planning",
        "Financial goals and security",
        "Work-life balance and income",
        "Spending habits and values alignment"
      ],
      "key_questions": [
        {
          "id": "financial_stress",
          "text": "How often do financial concerns affect your physical or mental health?",
          "impact_areas": ["Sleep quality", "Stress levels", "Relationship quality", "Work performance", "Healthcare decisions"]
        },
        {
          "id": "financial_habits",
          "text": "Which financial habits describe you?",
          "habits": ["I track expenses regularly", "I save consistently", "I have emergency fund", "I invest for future", "I avoid debt", "I spend mindfully"]
        }
      ]
    },
    {
      "domain": "Intellectual Wellness",
      "description": "Mental stimulation, learning, and cognitive health",
      "focus_areas": [
        "Continuous learning and curiosity",
        "Creative expression",
        "Problem-solving skills",
        "Cognitive challenges",
        "Knowledge sharing and mentorship"
      ],
      "key_questions": [
        {
          "id": "learning_patterns",
          "text": "How do you engage your mind outside of work requirements?",
          "learning_activities": ["Reading books/articles", "Taking courses", "Learning new skills", "Creative hobbies", "Puzzles and games", "Teaching others"]
        },
        {
          "id": "cognitive_health",
          "text": "How would you rate your mental sharpness in these areas?",
          "cognitive_areas": ["Memory and recall", "Focus and concentration", "Problem-solving", "Creativity", "Learning speed", "Decision making"]
        }
      ]
    },
    {
      "domain": "Digital Wellness",
      "description": "Healthy relationship with technology and digital life",
      "focus_areas": [
        "Screen time management",
        "Social media usage",
        "Digital boundaries",
        "Online vs offline balance",
        "Technology for wellness vs distraction"
      ],
      "key_questions": [
        {
          "id": "digital_boundaries",
          "text": "How well do you maintain healthy boundaries with technology?",
          "boundary_areas": ["Work hours", "Meal times", "Social media", "Email/notifications", "Screen before bed", "Weekend disconnect"]
        },
        {
          "id": "tech_impact",
          "text": "How does technology use affect your daily wellbeing?",
          "impact_areas": ["Sleep quality", "Face-to-face relationships", "Physical activity", "Mental focus", "Stress levels", "Productivity"]
        }
      ]
    }
  ],

  "integrated_assessment_flows": [
    {
      "name": "Complete Wellness Check-in",
      "duration": "15-20 minutes",
      "domains": ["physical", "mental", "emotional", "social", "environmental"],
      "adaptive_pathing": true,
      "question_count": "25-35"
    },
    {
      "name": "Quick Wellness Pulse",
      "duration": "5-7 minutes",
      "domains": ["physical", "mental", "emotional"],
      "focus": "Recent changes and current priorities",
      "question_count": "8-12"
    },
    {
      "name": "Domain Deep Dive",
      "duration": "10-15 minutes",
      "single_domain_focus": true,
      "comprehensive_coverage": true,
      "question_count": "15-20"
    },
    {
      "name": "Life Transition Assessment",
      "duration": "20-25 minutes",
      "domains": ["all"],
      "context_specific": true,
      "scenario": "major life changes (new job, move, relationship changes, etc.)",
      "question_count": "30-40"
    }
  ],

  "adaptive_question_logic": [
    {
      "trigger": {"question": "sleep_quality", "answer": {"min": 1, "max": 3}},
      "action": "ask_follow_up_questions",
      "follow_ups": ["sleep_environment", "sleep_schedule", "stress_impact"]
    },
    {
      "trigger": {"question": "exercise_frequency", "answer": {"max": 1}},
      "action": "explore_barriers",
      "barrier_categories": ["time", "motivation", "physical_limitations", "knowledge", "resources"]
    },
    {
      "trigger": {"question": "stress_triggers", "answer": "work_pressure"},
      "action": "work_life_balance_deep_dive",
      "focus_areas": ["boundaries", "time_management", "support_systems"]
    }
  ]
}