# ================================
# PsychSync Frontend Environment
# ================================

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ENABLE_SECURITY_MONITORING=true
VITE_ENABLE_XSS_PROTECTION=true
VITE_SESSION_TIMEOUT=1800000
VITE_MAX_SESSION_AGE=86400000

# Performance Configuration
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_BUNDLE_ANALYZER=false
VITE_SOURCEMAP=false

# Analytics and Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Debug Configuration
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_LOG_LEVEL=warn

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
VITE_ENABLE_ADVANCED_ANALYTICS=false

# Environment Settings
VITE_NODE_ENV=development
VITE_BUILD_VERSION=1.0.0
VITE_BUILD_DATE=

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_STRIPE_PUBLIC_KEY=

# Security Headers
VITE_CSP_NONCE=
VITE_FRAME_ANCESTORS=none
VITE_REFERRER_POLICY=strict-origin-when-cross-origin

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# File Upload Security
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# Cache Configuration
VITE_CACHE_TIMEOUT=300000
VITE_ENABLE_SERVICE_WORKER=false

# Development Only
VITE_MOCK_API=false
VITE_HOT_RELOAD=true
VITE_DEVTOOLS_ENABLED=true
