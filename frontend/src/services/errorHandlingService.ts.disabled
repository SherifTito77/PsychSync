// Enhanced Error Handling Service for AI Engine
import { toast } from 'react-toastify';

export interface ErrorContext {
  component: string;
  action: string;
  user?: any;
  timestamp: string;
  retryCount?: number;
}

export interface ErrorHandlingOptions {
  showToast?: boolean;
  logToConsole?: boolean;
  reportToServer?: boolean;
  retry?: boolean;
  fallback?: () => any;
}

export interface ErrorReport {
  error: Error;
  context: ErrorContext;
  userAgent: string;
  url: string;
  timestamp: string;
  resolved: boolean;
}

class ErrorHandlingService {
  private errorReports: ErrorReport[] = [];
  private maxErrorReports = 100;

  /**
   * Handle AI-related errors with comprehensive fallback strategies
   */
  async handleAIError(
    error: Error,
    context: ErrorContext,
    options: ErrorHandlingOptions = {}
  ): Promise<any> {
    const defaultOptions: ErrorHandlingOptions = {
      showToast: true,
      logToConsole: true,
      reportToServer: true,
      retry: context.retryCount ? context.retryCount < 3 : true,
      fallback: this.getDefaultFallback(context.action)
    };

    const finalOptions = { ...defaultOptions, ...options };

    // Log error
    if (finalOptions.logToConsole) {
      this.logError(error, context);
    }

    // Report to server
    if (finalOptions.reportToServer) {
      this.reportErrorToServer(error, context);
    }

    // Show user feedback
    if (finalOptions.showToast) {
      this.showErrorToast(error, context);
    }

    // Retry logic
    if (finalOptions.retry && context.retryCount && context.retryCount < 3) {
      const retryContext = { ...context, retryCount: context.retryCount + 1 };
      return this.retryWithBackoff(context.action, retryContext);
    }

    // Fallback response
    if (finalOptions.fallback) {
      return finalOptions.fallback();
    }

    throw error;
  }

  /**
   * Handle network-related errors
   */
  handleNetworkError(error: Error, context: ErrorContext): void {
    const isOffline = !navigator.onLine;
    const isTimeout = error.message.includes('timeout');
    const isConnectionRefused = error.message.includes('ECONNREFUSED');

    if (isOffline) {
      this.showOfflineMessage();
    } else if (isTimeout || isConnectionRefused) {
      this.showConnectionErrorMessage(context);
    } else {
      this.handleAIError(error, context, {
        showToast: true,
        retry: true,
        fallback: this.getNetworkFallback()
      });
    }
  }

  /**
   * Handle authentication errors
   */
  handleAuthError(error: Error, context: ErrorContext): void {
    if (error.message.includes('401') || error.message.includes('403')) {
      toast.error('Your session has expired. Please log in again.', {
        position: 'top-right',
        autoClose: 5000,
        theme: 'colored'
      });

      // Clear auth tokens
      localStorage.removeItem('access_token');
      localStorage.removeItem('refresh_token');
      localStorage.removeItem('user');

      // Redirect to login after a short delay
      setTimeout(() => {
        window.location.href = '/login';
      }, 2000);
    } else {
      this.handleAIError(error, context);
    }
  }

  /**
   * Handle validation errors
   */
  handleValidationError(error: Error, context: ErrorContext): void {
    toast.error(`Please check your input: ${error.message}`, {
      position: 'top-right',
      autoClose: 4000,
      theme: 'colored'
    });
  }

  /**
   * Get default fallback based on action type
   */
  private getDefaultFallback(action: string): () => any {
    const fallbacks = {
      'testAIEngine': () => ({
        success: false,
        message: 'AI engine temporarily unavailable',
        fallback: true,
        cached_result: this.getCachedAIResult()
      }),
      'getMBTIInsights': () => ({
        type: 'INTJ',
        description: 'The Architect - Imaginative and strategic thinkers',
        confidence: 0.7,
        fallback: true,
        basic_insights: ['Basic personality analysis available']
      }),
      'processAssessment': () => ({
        success: false,
        error: 'AI processing unavailable',
        fallback: true,
        basic_analysis: true
      }),
      'processUserAssessment': () => ({
        success: false,
        message: 'Enhanced AI features temporarily unavailable',
        fallback: true,
        basic_mode: true
      })
    };

    return fallbacks[action] || () => ({
      success: false,
      message: 'AI service temporarily unavailable',
      fallback: true
    });
  }

  /**
   * Get network-specific fallback
   */
  private getNetworkFallback(): () => any {
    return () => ({
      success: false,
      network_issue: true,
      message: 'Network connectivity issues detected',
      offline_mode: true,
      cached_data: this.getCachedData()
    });
  }

  /**
   * Get cached AI result if available
   */
  private getCachedAIResult(): any {
    const cached = localStorage.getItem('ai_last_result');
    return cached ? JSON.parse(cached) : null;
  }

  /**
   * Get cached data for offline mode
   */
  private getCachedData(): any {
    return {
      personality_frameworks: ['MBTI', 'Enneagram', 'Big Five'],
      basic_descriptions: 'Basic personality analysis available offline'
    };
  }

  /**
   * Retry with exponential backoff
   */
  private async retryWithBackoff(action: string, context: ErrorContext): Promise<any> {
    const delay = Math.pow(2, context.retryCount || 1) * 1000; // Exponential backoff

    await new Promise(resolve => setTimeout(resolve, delay));

    toast.info(`Retrying... Attempt ${context.retryCount || 1}`, {
      position: 'top-right',
      autoClose: 2000,
      theme: 'colored'
    });

    // Dispatch retry event that components can listen to
    window.dispatchEvent(new CustomEvent('ai-retry', {
      detail: { action, context, retryCount: context.retryCount }
    }));

    // This will be handled by the calling component
    throw new Error('Retry initiated');
  }

  /**
   * Log error to console with detailed information
   */
  private logError(error: Error, context: ErrorContext): void {
    const errorInfo = {
      message: error.message,
      stack: error.stack,
      context: context,
      timestamp: new Date().toISOString(),
      userAgent: navigator.userAgent
    };

    console.group(`🚨 AI Error in ${context.component}: ${context.action}`);
    console.error('Error Details:', errorInfo);
    console.groupEnd();
  }

  /**
   * Report error to server for monitoring
   */
  private async reportErrorToServer(error: Error, context: ErrorContext): Promise<void> {
    try {
      const errorReport: ErrorReport = {
        error,
        context,
        userAgent: navigator.userAgent,
        url: window.location.href,
        timestamp: new Date().toISOString(),
        resolved: false
      };

      this.errorReports.push(errorReport);

      // Keep only recent error reports
      if (this.errorReports.length > this.maxErrorReports) {
        this.errorReports = this.errorReports.slice(-this.maxErrorReports);
      }

      // Send to error tracking endpoint (if available)
      await fetch('/api/v1/error-report', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(errorReport)
      }).catch(() => {
        // Silently fail error reporting to avoid infinite loops
      });
    } catch (reportingError) {
      console.warn('Failed to report error to server:', reportingError);
    }
  }

  /**
   * Show appropriate error toast
   */
  private showErrorToast(error: Error, context: ErrorContext): void {
    const isNetworkError = error.message.includes('fetch') ||
                         error.message.includes('network') ||
                         error.message.includes('ECONNREFUSED');

    const isServerError = error.message.includes('500') ||
                        error.message.includes('502') ||
                        error.message.includes('503');

    let message = 'An error occurred while processing your request';
    let toastType: 'error' | 'warning' | 'info' = 'error';

    if (isNetworkError) {
      message = 'Network connectivity issues detected. Please check your connection.';
      toastType = 'warning';
    } else if (isServerError) {
      message = 'Server is temporarily unavailable. Please try again in a moment.';
      toastType = 'warning';
    } else if (context.retryCount && context.retryCount > 0) {
      message = `Still having issues (Attempt ${context.retryCount}). Our team has been notified.`;
      toastType = 'info';
    }

    toast(message, {
      position: 'top-right',
      autoClose: toastType === 'error' ? 6000 : 4000,
      theme: 'colored',
      type: toastType,
      onClick: () => this.showErrorDetails(error, context)
    });
  }

  /**
   * Show offline message
   */
  private showOfflineMessage(): void {
    toast.error('You appear to be offline. Please check your internet connection.', {
      position: 'top-right',
      autoClose: false,
      theme: 'colored',
      closeButton: true
    });
  }

  /**
   * Show connection error message
   */
  private showConnectionErrorMessage(context: ErrorContext): void {
    toast.error('Unable to connect to our servers. Please try again in a moment.', {
      position: 'top-right',
      autoClose: 5000,
      theme: 'colored'
    });
  }

  /**
   * Show detailed error information
   */
  private showErrorDetails(error: Error, context: ErrorContext): void {
    console.group('🔍 Detailed Error Information');
    console.log('Error:', error);
    console.log('Context:', context);
    console.log('Timestamp:', new Date().toISOString());
    console.groupEnd();

    toast.info('Error details logged to console (F12 → Console)', {
      position: 'top-right',
      autoClose: 3000,
      theme: 'colored'
    });
  }

  /**
   * Get error statistics for monitoring
   */
  getErrorStats(): {
    totalErrors: number;
    recentErrors: ErrorReport[];
    errorsByComponent: Record<string, number>;
  } {
    const errorsByComponent: Record<string, number> = {};

    this.errorReports.forEach(report => {
      const component = report.context.component;
      errorsByComponent[component] = (errorsByComponent[component] || 0) + 1;
    });

    return {
      totalErrors: this.errorReports.length,
      recentErrors: this.errorReports.slice(-10),
      errorsByComponent
    };
  }

  /**
   * Clear error reports
   */
  clearErrorReports(): void {
    this.errorReports = [];
  }

  /**
   * Wrap async function with error handling
   */
  async withErrorHandling<T>(
    asyncFn: () => Promise<T>,
    context: ErrorContext,
    options: ErrorHandlingOptions = {}
  ): Promise<T> {
    try {
      return await asyncFn();
    } catch (error) {
      if (error instanceof Error) {
        return this.handleAIError(error, context, options);
      }
      throw error;
    }
  }
}

// Create singleton instance
export const errorHandlingService = new ErrorHandlingService();

// Export default
export default errorHandlingService;