[bandit]
# Bandit configuration for security scanning
# Install: pip install bandit[toml]
# Run: bandit -r app/ -c pyproject.toml
# Docs: https://bandit.readthedocs.io/

# Directories to exclude from scanning
exclude_dirs = [
    '/.venv',
    '/tests',
    '/migrations',
    '/node_modules',
]

# Tests to skip (can be overridden with --skip command-line option)
skips = [
    'B101',  # Allow assert statements (needed for tests)
]

# Tests to include (empty means all)
# tests = ['B201', 'B301']

# Plugins to load
# plugins = []

# Show which tests were skipped in output
# show_skips = true
