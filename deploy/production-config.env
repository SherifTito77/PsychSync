# ==========================================
# PsychSync Production Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=PsychSync
APP_VERSION=2.0.0
APP_URL=https://app.psychsync.com
API_URL=https://api.psychsync.com

# Security Configuration
SECRET_KEY=${PSYCHSYNC_SECRET_KEY}
JWT_SECRET_KEY=${PSYCHSYNC_JWT_SECRET}
ENCRYPTION_KEY=${PSYCHSYNC_ENCRYPTION_KEY}
CORS_ORIGINS=https://app.psychsync.com,https://www.psychsync.com
ALLOWED_HOSTS=app.psychsync.com,api.psychsync.com,psychsync.com

# Database Configuration (PostgreSQL Cluster)
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db-primary.psychsync.internal:5432/psychsync?sslmode=require
DATABASE_READ_URL=postgresql://postgres:${DB_PASSWORD}@db-replica.psychsync.internal:5432/psychsync?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration (Cluster)
REDIS_URL=redis://redis-cluster.psychsync.internal:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_POOL_SIZE=50
REDIS_MAX_CONNECTIONS=100

# Storage & CDN Configuration
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_KEY}
AWS_REGION=us-east-1
S3_BUCKET_NAME=psychsync-production
CDN_DOMAIN=cdn.psychsync.com
STATIC_URL=https://cdn.psychsync.com

# Email Configuration (SendGrid)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=${SENDGRID_API_USER}
EMAIL_PASSWORD=${SENDGRID_API_KEY}
EMAIL_FROM=noreply@psychsync.com
EMAIL_FROM_NAME=PsychSync

# Authentication & OAuth
GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_OAUTH_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
MICROSOFT_OAUTH_CLIENT_ID=${MICROSOFT_CLIENT_ID}
MICROSOFT_OAUTH_CLIENT_SECRET=${MICROSOFT_CLIENT_SECRET}
SLACK_OAUTH_CLIENT_ID=${SLACK_CLIENT_ID}
SLACK_OAUTH_CLIENT_SECRET=${SLACK_CLIENT_SECRET}

# Payment & Billing (Stripe)
STRIPE_SECRET_KEY=${STRIPE_PRODUCTION_SECRET_KEY}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_CONNECT_CLIENT_ID=${STRIPE_CONNECT_CLIENT_ID}
STRIPE_CONNECT_SECRET=${STRIPE_CONNECT_SECRET}

# Analytics & Monitoring
SENTRY_DSN=${SENTRY_PRODUCTION_DSN}
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=${MIXPANEL_PRODUCTION_TOKEN}
AMPLITITUDE_API_KEY=${AMPLITUDE_PRODUCTION_KEY}
POSTHOG_API_KEY=${POSTHOG_PRODUCTION_KEY}

# Feature Flags (LaunchDarkly or self-hosted)
FEATURE_FLAG_SERVICE_URL=https://flags.psychsync.com
FEATURE_FLAG_SDK_KEY=${FEATURE_FLAG_SDK_KEY}

# AI & ML Services
OPENAI_API_KEY=${OPENAI_PRODUCTION_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_PRODUCTION_KEY}
COHERE_API_KEY=${COHERE_PRODUCTION_KEY}
HUGGINGFACE_API_KEY=${HUGGINGFACE_API_KEY}

# Search & Indexing (Algolia)
ALGOLIA_APP_ID=${ALGOLIA_PRODUCTION_APP_ID}
ALGOLIA_API_KEY=${ALGOLIA_PRODUCTION_API_KEY}
ALGOLIA_SEARCH_API_KEY=${ALGOLIA_SEARCH_API_KEY}

# Push Notifications
ONESIGNAL_APP_ID=${ONESIGNAL_PRODUCTION_APP_ID}
ONESIGNAL_API_KEY=${ONESIGNAL_PRODUCTION_API_KEY}
FCM_SERVER_KEY=${FCM_PRODUCTION_SERVER_KEY}

# SMS & Voice (Twilio)
TWILIO_ACCOUNT_SID=${TWILIO_PRODUCTION_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_PRODUCTION_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PRODUCTION_PHONE_NUMBER}

# File Processing & Storage
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_PRODUCTION_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_PRODUCTION_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_PRODUCTION_API_SECRET}

# Rate Limiting & Security
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600
IP_RATE_LIMIT_REQUESTS=100
IP_RATE_LIMIT_WINDOW=60
SECURITY_HEADERS_ENABLED=true
CORS_ENABLED=true
CSRF_PROTECTION_ENABLED=true

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=psychsync:prod:
CACHE_REDIS_URL=redis://redis-cluster.psychsync.internal:6379/1

# Background Jobs (Celery/Redis)
CELERY_BROKER_URL=redis://redis-cluster.psychsync.internal:6379/2
CELERY_RESULT_BACKEND=redis://redis-cluster.psychsync.internal:6379/3
CELERY_WORKER_CONCURRENCY=10
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# Elasticsearch Configuration
ELASTICSEARCH_URL=https://elasticsearch.psychsync.internal:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}
ELASTICSEARCH_INDEX_PREFIX=psychsync-prod

# Log Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/psychsync.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=false

# Monitoring & Health Checks
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://jaeger.psychsync.internal:14268/api/traces

# Security & Compliance
GDPR_ENABLED=true
CCPA_ENABLED=true
SOC2_ENABLED=true
HIPAA_ENABLED=false
DATA_ENCRYPTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
SECURITY_SCAN_ENABLED=true

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_S3_BUCKET=psychsync-backups-prod
BACKUP_ENCRYPTION_ENABLED=true
DISASTER_RECOVERY_ENABLED=true
REPLICATION_ENABLED=true

# Performance Optimization
GZIP_ENABLED=true
COMPRESSION_LEVEL=6
STATIC_FILE_COMPRESSION=true
IMAGE_OPTIMIZATION_ENABLED=true
LAZY_LOADING_ENABLED=true
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100

# Localization & Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,zh,ko,ru
TIMEZONE=UTC
CURRENCY=USD
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H:%M:%S