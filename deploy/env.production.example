# PsychSync Production Environment Configuration
# Stack: AWS App Runner + Supabase + Upstash + Vercel
#
# INSTRUCTIONS:
# 1. Fill in all values marked with [CHANGE_ME]
# 2. Set these as environment variables in AWS App Runner console
# 3. NEVER commit actual values to git

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=production
DEBUG=false
TESTING=false
PROJECT_NAME=PsychSync AI
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ============================================================
# SECURITY (generate fresh values for production)
# ============================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(128))"
SECRET_KEY=[CHANGE_ME]

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=[CHANGE_ME]

# Optional: separate master key for advanced operations
ENCRYPTION_MASTER_KEY=[CHANGE_ME]

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# IMPORTANT: Use port 6543 (connection pooler), NOT 5432
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Pool settings (keep low for Supabase pooler limits)
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_TIMEOUT=30

# SSL (Supabase always uses SSL)
DB_SSL_MODE=require
DB_ECHO=false
DB_POOL_PRE_PING=true

# ============================================================
# REDIS (Upstash Serverless Redis)
# ============================================================
# Get from: Upstash Console → Your Database → Details
# NOTE: Use rediss:// (double-s) for TLS
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_PASSWORD=[CHANGE_ME]
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# ============================================================
# CORS & HOSTS
# ============================================================
FRONTEND_URL=https://app.psychsync.com
ADMIN_FRONTEND_URL=https://admin.psychsync.com
CORS_ORIGINS=https://app.psychsync.com,https://admin.psychsync.com
ALLOWED_HOSTS=api.psychsync.com,*.awsapprunner.com

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true

# ============================================================
# EMAIL (SendGrid or SMTP)
# ============================================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASSWORD=[CHANGE_ME_SENDGRID_API_KEY]
EMAILS_FROM_EMAIL=noreply@psychsync.com
EMAILS_FROM_NAME=PsychSync

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=[CHANGE_ME_OR_LEAVE_EMPTY]
SECURITY_MONITORING_ENABLED=true

# ============================================================
# FEATURES
# ============================================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
CACHE_ENABLED=true

# ============================================================
# FILE STORAGE (AWS S3)
# ============================================================
# AWS_ACCESS_KEY_ID=[CHANGE_ME]
# AWS_SECRET_ACCESS_KEY=[CHANGE_ME]
# AWS_S3_BUCKET=psychsync-uploads
# AWS_REGION=us-east-1
