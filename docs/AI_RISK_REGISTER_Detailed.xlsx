# Create DataFrame
df = pd.DataFrame(risk_data)

# Save to Excel
output_file = '/Users/sheriftito/Downloads/psychsync/docs/AI_RISK_REGISTER_Detailed.xlsx'

# Create Excel writer with multiple sheets
with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
    # Main risk register
    df.to_excel(writer, sheet_name='Risk Register', index=False)

    # Summary statistics
    summary_data = {
        'Category': df.groupby('Category').size().index,
        'Count': df.groupby('Category').size().values
    }
    summary_df = pd.DataFrame(summary_data)
    summary_df.to_excel(writer, sheet_name='Summary by Category', index=False)

    # NIST function breakdown
    nist_data = {
        'NIST Function': df.groupby('NIST Function').size().index,
        'Count': df.groupby('NIST Function').size().values
    }
    nist_df = pd.DataFrame(nist_data)
    nist_df.to_excel(writer, sheet_name='NIST Functions', index=False)

    # OWASP mapping
    owasp_df = df[df['OWASP LLM Top 10'] != 'N/A'][['Risk ID', 'Risk Name', 'OWASP LLM Top 10', 'Risk Score', 'Status']]
    owasp_df.to_excel(writer, sheet_name='OWASP LLM Top 10', index=False)

    # Risk score analysis
    df['Risk Score'] = pd.to_numeric(df['Risk Score'])
    score_bins = [0, 8, 15, 25]
    score_labels = ['Low (1-8)', 'Medium (9-15)', 'High (16-25)']
    df['Risk Level'] = pd.cut(df['Risk Score'], bins=score_bins, labels=score_labels, include_lowest=True)
    risk_level_df = df.groupby('Risk Level').size().reset_index(name='Count')
    risk_level_df.to_excel(writer, sheet_name='Risk Level Analysis', index=False)

    # Status tracking
    status_df = df.groupby('Status').size().reset_index(name='Count')
    status_df.to_excel(writer, sheet_name='Status Tracking', index=False)

    # Timeline analysis
    timeline_df = df.groupby('Timeline').agg({
        'Risk ID': 'count',
        'Budget': 'sum'
    }).rename(columns={'Risk ID': 'Risk Count'})
    timeline_df.to_excel(writer, sheet_name='Timeline & Budget', index=True)

print(f"✅ AI Risk Register created: {output_file}")
print(f"📊 Total risks: {len(df)}")
print(f"📋 Sheets: Risk Register, Summary, NIST Functions, OWASP LLM Top 10, Risk Levels, Status, Timeline")
