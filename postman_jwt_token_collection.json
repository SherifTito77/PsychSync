          },
          "response": []
        },
        {
          "name": "🚫 Refresh Token Reuse Protection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Refresh token reuse rejected\", function() {",
                  "    // Should fail if refresh tokens are single-use",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test(\"Error message appropriate\", function() {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('detail');",
                  "    const detail = jsonData.detail.toLowerCase();",
                  "    ",
                  "    // Should contain security-related error",
                  "    const securityKeywords = ['invalid', 'expired', 'revoked', 'used', 'blacklist'];",
                  "    const hasSecurityKeyword = securityKeywords.some(keyword => detail.includes(keyword));",
                  "    pm.expect(hasSecurityKeyword).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        }
      ]
