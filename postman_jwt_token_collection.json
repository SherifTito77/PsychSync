                  "    sub: 'admin@example.com',",
                  "    exp: Math.floor(Date.now() / 1000) + 3600,",
                  "    iat: Math.floor(Date.now() / 1000),",
                  "    type: 'access'",
                  "})).toString('base64').replace(/=/g, '');",
                  "const wrongSignature = 'wrong_signature_here';",
