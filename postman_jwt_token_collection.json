                  "console.log('=== JWT Token Analysis ===');",
                  "console.log('Login Time:', loginTime);",
                  "console.log('Access Token Length:', accessToken ? accessToken.length : 'N/A');",
                  "console.log('Refresh Token Length:', refreshToken ? refreshToken.length : 'N/A');",
                  "",
                  "if (accessToken) {",
                  "    const parts = accessToken.split('.');",
                  "    try {",
                  "        const payload = JSON.parse(atob(parts[1]));",
                  "        console.log('Token Subject:', payload.sub);",
                  "        console.log('Token Type:', payload.type);",
                  "        console.log('Issued At:', new Date(payload.iat * 1000).toISOString());",
                  "        console.log('Expires At:', new Date(payload.exp * 1000).toISOString());",
                  "        console.log('Token Lifetime (minutes):', (payload.exp - payload.iat) / 60);",
                  "    } catch (e) {",
                  "        console.log('Error parsing token:', e.message);",
                  "    }",
                  "}",
