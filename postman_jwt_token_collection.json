{
  "info": {
    "_postman_id": "jwt-token-test-suite-2024",
    "name": "PsychSync JWT Token Test Suite",
    "description": "Comprehensive JWT token testing including expiration, refresh, and security validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 JWT Token Authentication",
      "item": [
        {
          "name": "📝 User Login for Token Generation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Tokens returned\", function() {",
                  "    const jsonData = pm.response.json();",
                  "    ",
                  "    if (jsonData.data) {",
                  "        pm.expect(jsonData.data).to.have.property('access_token');",
                  "        pm.expect(jsonData.data).to.have.property('refresh_token');",
                  "        ",
                  "        // Store tokens for subsequent tests",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "    } else if (jsonData.access_token) {",
                  "        pm.expect(jsonData).to.have.property('access_token');",
                  "        pm.expect(jsonData).to.have.property('refresh_token');",
                  "        ",
                  "        pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Token structure validation\", function() {",
                  "    const accessToken = pm.collectionVariables.get('accessToken');",
                  "    const refreshToken = pm.collectionVariables.get('refreshToken');",
                  "    ",
                  "    // JWT tokens should have 3 parts separated by dots",
                  "    pm.expect(accessToken).to.match(/^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$/);",
                  "    pm.expect(refreshToken).to.match(/^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$/);",
                  "});",
                  "",
                  "// Store timestamp for expiration testing",
                  "pm.collectionVariables.set('loginTime', new Date().toISOString());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin@12345",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "⏰ JWT Expiration Tests",
      "item": [
        {
          "name": "✅ Fresh Access Token Validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Fresh token works\", function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"User data returned\", function() {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    if (jsonData.data) {",
                  "        pm.expect(jsonData.data).to.have.property('email');",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Response time reasonable\", function() {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "🔍 Access Token Structure Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Decode JWT token without verification for analysis",
                  "const accessToken = pm.collectionVariables.get('accessToken');",
                  "const parts = accessToken.split('.');",
                  "",
                  "pm.test(\"JWT token has correct structure\", function() {",
                  "    pm.expect(parts).to.have.lengthOf(3);",
                  "    pm.expect(parts[0]).to.not.be.empty;",
                  "    pm.expect(parts[1]).to.not.be.empty;",
                  "    pm.expect(parts[2]).to.not.be.empty;",
                  "});",
                  "",
                  "// Decode payload",
                  "try {",
                  "    const payload = JSON.parse(atob(parts[1]));",
                  "    ",
                  "    pm.test(\"Token has required claims\", function() {",
                  "        pm.expect(payload).to.have.property('sub');",
                  "        pm.expect(payload).to.have.property('exp');",
                  "        pm.expect(payload).to.have.property('iat');",
                  "        pm.expect(payload).to.have.property('type');",
                  "        pm.expect(payload.type).to.eql('access');",
                  "    });",
                  "    ",
                  "    pm.test(\"Token expiration reasonable\", function() {",
                  "        const now = Math.floor(Date.now() / 1000);",
                  "        const exp = payload.exp;",
                  "        const iat = payload.iat;",
                  "        const duration = exp - iat;",
                  "        ",
                  "        // Access token should expire in ~30 minutes (1800 seconds)",
                  "        pm.expect(duration).to.be.within(1500, 2100);",
                  "        pm.expect(exp).to.be.above(now);",
                  "    });",
                  "    ",
                  "    // Store expiration info for later tests",
                  "    pm.collectionVariables.set('tokenExp', payload.exp);",
                  "    pm.collectionVariables.set('tokenIat', payload.iat);",
                  "    ",
                  "} catch (e) {",
                  "    pm.test(\"JWT payload parsing\", function() {",
                  "        pm.fail('Failed to parse JWT payload: ' + e.message);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "🕒 Token Near Expiration Edge Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Token near expiration behavior\", function() {",
                  "    // Test should still work if token is not yet expired",
                  "    const tokenExp = pm.collectionVariables.get('tokenExp');",
                  "    const now = Math.floor(Date.now() / 1000);",
                  "    const timeToExp = tokenExp - now;",
                  "    ",
                  "    if (timeToExp > 0) {",
                  "        // Token should still work",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "        pm.test(`Token expires in ${timeToExp} seconds`, function() {",
                  "            pm.expect(timeToExp).to.be.above(0);",
                  "        });",
                  "    } else {",
                  "        // Token should be expired",
                  "        pm.expect(pm.response.code).to.eql(401);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔄 JWT Refresh Token Tests",
      "item": [
        {
          "name": "🔍 Refresh Token Structure Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Decode refresh token for analysis",
                  "const refreshToken = pm.collectionVariables.get('refreshToken');",
                  "const parts = refreshToken.split('.');",
                  "",
                  "pm.test(\"Refresh token has correct structure\", function() {",
                  "    pm.expect(parts).to.have.lengthOf(3);",
                  "});",
                  "",
                  "try {",
                  "    const payload = JSON.parse(atob(parts[1]));",
                  "    ",
                  "    pm.test(\"Refresh token has correct claims\", function() {",
                  "        pm.expect(payload).to.have.property('sub');",
                  "        pm.expect(payload).to.have.property('exp');",
                  "        pm.expect(payload).to.have.property('type');",
                  "        pm.expect(payload.type).to.eql('refresh');",
                  "    });",
                  "    ",
                  "    pm.test(\"Refresh token lifetime reasonable\", function() {",
                  "        const now = Math.floor(Date.now() / 1000);",
                  "        const exp = payload.exp;",
                  "        const iat = payload.iat;",
                  "        const duration = exp - iat;",
                  "        ",
                  "        // Refresh token should last ~7 days (604800 seconds)",
                  "        pm.expect(duration).to.be.within(518400, 691200); // 6-8 days",
                  "        pm.expect(exp).to.be.above(now + 86400); // At least 1 day from now",
                  "    });",
                  "    ",
                  "    // Store refresh token expiration",
                  "    pm.collectionVariables.set('refreshTokenExp', payload.exp);",
                  "    ",
                  "} catch (e) {",
                  "    pm.test(\"Refresh token parsing\", function() {",
                  "        pm.fail('Failed to parse refresh token: ' + e.message);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "✅ Valid Token Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Token refresh successful\", function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"New access token returned\", function() {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    if (jsonData.data) {",
                  "        pm.expect(jsonData.data).to.have.property('access_token');",
                  "        ",
                  "        // Store new access token",
                  "        pm.collectionVariables.set('newAccessToken', jsonData.data.access_token);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"New token is different\", function() {",
                  "    const oldToken = pm.collectionVariables.get('accessToken');",
                  "    const newToken = pm.collectionVariables.get('newAccessToken');",
                  "    pm.expect(newToken).to.not.eql(oldToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "✅ Refreshed Token Validation",
          "event": [
