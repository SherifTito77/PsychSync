                  "})).replace(/=/g, '');",
                  "const wrongSignature = 'wrong_signature_here';",
                  "const malformedToken = `${header}.${payload}.${wrongSignature}`;",
                  "",
                  "pm.globals.set('malformedToken', malformedToken);"
                ],
                "type": "text/javascript"
              }
            },
