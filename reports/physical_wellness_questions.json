{
  "domain": "Physical Wellness",
  "description": "Comprehensive assessment of physical health habits and lifestyle patterns",
  "estimated_time": "3-4 minutes",
  "questions": [
    {
      "id": "phys_focus_area",
      "type": "multiple_choice",
      "text": "Which aspect of your physical wellness matters most to you right now?",
      "description": "This helps us personalize your recommendations",
      "options": [
        {
          "value": "energy",
          "text": "⚡ Energy & Vitality",
          "subtext": "Feeling energized throughout the day"
        },
        {
          "value": "sleep",
          "text": "😴 Sleep Quality",
          "subtext": "Getting restful, sufficient sleep"
        },
        {
          "value": "exercise",
          "text": "🏃 Physical Activity",
          "subtext": "Regular movement and exercise"
        },
        {
          "value": "nutrition",
          "text": "🥗 Nutrition Habits",
          "subtext": "Balanced eating patterns"
        },
        {
          "value": "pain_management",
          "text": "💪 Pain & Comfort",
          "subtext": "Managing aches, pains, or discomfort"
        },
        {
          "value": "prevention",
          "text": "🛡️ Preventive Health",
          "subtext": "Staying healthy and preventing issues"
        }
      ],
      "required": true
    },
    {
      "id": "sleep_quality",
      "type": "behavioral_scale",
      "text": "How would you describe your typical sleep?",
      "description": "Think about your sleep patterns over the past month",
      "scale": {
        "min": 1,
        "max": 5,
        "labels": {
          "1": "💤 Consistently poor - difficulty falling/staying asleep",
          "2": "😕 Often restless - wake up tired most days",
          "3": "😐 Fair - some good nights, some bad nights",
          "4": "🙂 Generally good - most nights are restful",
          "5": "⭐ Excellent - consistently deep, restorative sleep"
        }
      },
      "follow_up": {
        "condition": {"min": 1, "max": 3},
        "question": "What's the biggest sleep challenge you face?",
        "options": [
          "Difficulty falling asleep",
          "Waking up frequently during night",
          "Waking up too early",
          "Not enough time for sleep",
          "Stress/anxiety affecting sleep"
        ]
      }
    },
    {
      "id": "energy_patterns",
      "type": "pattern_selection",
      "text": "Which energy pattern best describes your typical day?",
      "options": [
        {
          "value": "always_tired",
          "text": "🔋 Low Battery - Feel tired most of the day",
          "times": ["Wake up tired", "Afternoon crash", "Evening exhaustion"]
        },
        {
          "value": "morning_person",
          "text": "🌅 Morning Peak - Best energy in mornings",
          "times": ["Wake up energized", "Afternoon decline", "Evening tired"]
        },
        {
          "value": "afternoon_person",
          "text": "☀️ Afternoon Peak - Energy builds during day",
          "times": ["Slow start mornings", "Peak afternoon", "Decent evenings"]
        },
        {
          "value": "evening_person",
          "text": "🌙 Night Owl - Best energy in evenings",
          "times": ["Mornings are tough", "Moderate afternoons", "Energetic evenings"]
        },
        {
          "value": "consistent_energy",
          "text": "⚡ Steady - Consistent energy throughout day",
          "times": ["Wake up refreshed", "Stable afternoon", "Evening wind-down"]
        }
      ]
    },
    {
      "id": "exercise_frequency",
      "type": "behavioral_numeric",
      "text": "How many days per week do you get at least 30 minutes of moderate physical activity?",
      "description": "Moderate activity includes brisk walking, cycling, swimming, dancing, etc.",
      "range": {
        "min": 0,
        "max": 7,
        "labels": {
          "0": "Never",
          "1-2": "1-2 days",
          "3-4": "3-4 days",
          "5-6": "5-6 days",
          "7": "Daily"
        }
      },
      "follow_up_condition": {"max": 2},
      "follow_up": {
        "question": "What makes it challenging to exercise more regularly?",
        "type": "multi_select",
        "options": [
          "Don't have enough time",
          "Lack motivation/energy",
          "Physical limitations or pain",
          "Don't enjoy traditional exercise",
          "Cost of gym/equipment",
          "Work/schedule conflicts",
          "Don't know where to start",
          "Weather limitations"
        ]
      }
    },
    {
      "id": "exercise_enjoyment",
      "type": "preference_selection",
      "text": "Which types of physical activities do you enjoy most?",
      "description": "Select up to 3 options",
      "max_selections": 3,
      "options": [
        {
          "value": "walking",
          "text": "🚶 Walking or hiking",
          "category": "low_intensity"
        },
        {
          "value": "strength_training",
          "text": "💪 Weight training or bodyweight exercises",
          "category": "high_intensity"
        },
        {
          "value": "cardio",
          "text": "🏃 Running, cycling, or swimming",
          "category": "high_intensity"
        },
        {
          "value": "yoga",
          "text": "🧘 Yoga or stretching",
          "category": "low_intensity"
        },
        {
          "value": "sports",
          "text": "⚽ Team sports or games",
          "category": "moderate_intensity"
        },
        {
          "value": "dancing",
          "text": "💃 Dancing or fitness classes",
          "category": "moderate_intensity"
        },
        {
          "value": "outdoor",
          "text": "🏞️ Outdoor activities",
          "category": "variable_intensity"
        },
        {
          "value": "home_workout",
          "text": "🏠 Home exercise routines",
          "category": "variable_intensity"
        }
      ]
    },
    {
      "id": "nutrition_patterns",
      "type": "daily_habits",
      "text": "How often do you typically eat these types of meals?",
      "description": "Think about your eating patterns over the past week",
      "categories": [
        {
          "name": "fresh_vegetables",
          "text": "🥦 Fresh vegetables with main meals",
          "frequency_options": ["Never", "1-2 days/week", "3-4 days/week", "5-6 days/week", "Daily"]
        },
        {
          "name": "processed_foods",
          "text": "🍔 Highly processed foods (fast food, packaged meals)",
          "frequency_options": ["Never", "1-2 days/week", "3-4 days/week", "5-6 days/week", "Daily"]
        },
        {
          "name": "water_intake",
          "text": "💧 8+ glasses of water",
          "frequency_options": ["Never", "1-2 days/week", "3-4 days/week", "5-6 days/week", "Daily"]
        },
        {
          "name": "mindful_eating",
          "text": "🧘 Mindful eating (sitting down, no distractions)",
          "frequency_options": ["Never", "1-2 days/week", "3-4 days/week", "5-6 days/week", "Daily"]
        }
      ]
    },
    {
      "id": "pain_discomfort",
      "type": "body_check",
      "text": "Do you experience any of these physical discomforts regularly?",
