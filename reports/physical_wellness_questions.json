          "area": "core"
        },
        {
          "value": "joint_pain",
          "text": "🦴 Joint pain (knees, hips, etc.)",
          "area": "limbs"
        },
        {
          "value": "digestive",
          "text": "🤢 Digestive issues or discomfort",
          "area": "internal"
        },
        {
          "value": "muscle_soreness",
          "text": "💪 General muscle soreness",
          "area": "muscles"
        }
      ],
      "other_option": {
        "enabled": true,
        "text": "Other physical discomfort"
      }
