name: Quality Gates and Code Review

on:
  pull_request:
    branches: [main, develop]
  workflow_dispatch:

jobs:
  # Code Quality Metrics
  quality-metrics:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for better analysis

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'
          cache-dependency-path: frontend/package-lock.json

      - name: Install Python analysis tools
        run: |
          python -m pip install --upgrade pip
          pip install radon xenon McCabe complexity
          pip install -r requirements.txt

      - name: Install Node.js dependencies
        working-directory: ./frontend
        run: npm ci

      - name: Calculate Python code quality metrics
        run: |
          echo "## Python Code Quality Metrics" >> quality-metrics.md
          echo "" >> quality-metrics.md

          # Cyclomatic complexity
          echo "### Cyclomatic Complexity" >> quality-metrics.md
          radon cc app/ --min B --json > radon-report.json || true
          radon cc app/ --min B >> quality-metrics.md

          # Maintainability index
          echo "" >> quality-metrics.md
          echo "### Maintainability Index" >> quality-metrics.md
          radon mi app/ --show --json > maintainability-report.json || true
          radon mi app/ --show >> quality-metrics.md

          # Raw metrics
          echo "" >> quality-metrics.md
          echo "### Raw Metrics" >> quality-metrics.md
          radon raw app/ --json > raw-metrics.json || true
          radon raw app/ >> quality-metrics.md

      - name: Check code complexity thresholds
        run: |
          python scripts/check_complexity_thresholds.py || true

      - name: Analyze Python code structure
        run: |
          # Check for code duplication, large files, etc.
          python scripts/analyze_code_structure.py || true

      - name: Analyze Frontend code quality
        working-directory: ./frontend
        run: |
          npm run lint:json || true
          npm run analyze-bundle || true

      - name: Upload quality metrics
        uses: actions/upload-artifact@v3
        with:
          name: quality-metrics
          path: |
            quality-metrics.md
            radon-report.json
            maintainability-report.json
            raw-metrics.json

  # Test Coverage Validation
  coverage-validation:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-cov pytest-asyncio coverage-badge

      - name: Run tests with coverage
        run: |
          pytest --cov=app --cov-report=xml --cov-report=html --cov-report=json --cov-fail-under=80

      - name: Generate coverage badge
        run: |
          coverage-badge -o coverage-badge.svg

      - name: Upload coverage reports
        uses: actions/upload-artifact@v3
        with:
          name: coverage-reports
          path: |
            coverage.xml
            htmlcov/
            coverage.json
            coverage-badge.svg

      - name: Check coverage thresholds
        run: |
          python scripts/check_coverage_thresholds.py || true

  # Dependency Analysis
  dependency-analysis:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Python analysis tools
        run: |
          python -m pip install --upgrade pip
          pip install pipdeptree pip-check-updates
          pip install -r requirements.txt

      - name: Install Node.js dependencies
        working-directory: ./frontend
        run: npm ci

      - name: Analyze Python dependencies
        run: |
          echo "## Python Dependency Analysis" >> dependency-analysis.md
          echo "" >> dependency-analysis.md

          # Check for outdated dependencies
          echo "### Outdated Dependencies" >> dependency-analysis.md
          pip-check-updates --requirements requirements.txt >> dependency-analysis.md || true

          # Dependency tree
          echo "" >> dependency-analysis.md
          echo "### Dependency Tree" >> dependency-analysis.md
          pipdeptree --json > dependency-tree.json || true
          pipdeptree >> dependency-analysis.md || true

      - name: Analyze Node.js dependencies
        working-directory: ./frontend
        run: |
          npm outdated || true
          npm audit --audit-level moderate || true

      - name: Check for dependency vulnerabilities
        run: |
          safety check --json > safety-vulnerabilities.json || true
          safety check >> dependency-analysis.md || true

      - name: Upload dependency analysis
        uses: actions/upload-artifact@3
        with:
          name: dependency-analysis
          path: |
            dependency-analysis.md
            dependency-tree.json
            safety-vulnerabilities.json

  # Architecture Validation
  architecture-validation:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Install analysis tools
        run: |
          python -m pip install --upgrade pip
          pip install graphviz matplotlib networkx
          pip install -r requirements.txt

      - name: Validate clean architecture
        run: |
          python scripts/validate_clean_architecture.py || true

      - name: Check for circular dependencies
        run: |
          python scripts/circular_dependency_checker.py || true

      - name: Analyze module dependencies
        run: |
          python scripts/analyze_module_dependencies.py || true

      - name: Generate architecture diagram
        run: |
          python scripts/generate_architecture_diagram.py || true

      - name: Upload architecture validation
        uses: actions/upload-artifact@v3
        with:
          name: architecture-validation
          path: |
            architecture-report.md
            architecture-diagram.png
            dependency-graph.png

  # Documentation Quality
  documentation-quality:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Install documentation tools
        run: |
          python -m pip install --upgrade pip
          pip install mkdocs mkdocs-material
          pip install -r requirements.txt

      - name: Check API documentation
        run: |
          # Start application to generate OpenAPI spec
          python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &
          APP_PID=$!
          sleep 10

          # Fetch OpenAPI spec
          curl -f http://localhost:8000/openapi.json -o openapi-spec.json || true

          # Validate OpenAPI spec
          python scripts/validate_openapi_spec.py || true

          # Cleanup
          kill $APP_PID || true

      - name: Check documentation coverage
        run: |
          python scripts/documentation_coverage.py || true

      - name: Build documentation
        run: |
          if [ -f "mkdocs.yml" ]; then
            mkdocs build || true
          fi

      - name: Upload documentation quality
        uses: actions/upload-artifact@v3
        with:
          name: documentation-quality
          path: |
            openapi-spec.json
            documentation-coverage.json
            site/

  # Quality Gate Evaluation
  quality-gate-evaluation:
    runs-on: ubuntu-latest
    needs: [quality-metrics, coverage-validation, dependency-analysis, architecture-validation, documentation-quality]
    if: always()
    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v3

      - name: Evaluate quality gates
        run: |
          python scripts/evaluate_quality_gates.py \
            --quality-metrics-dir quality-metrics/ \
            --coverage-dir coverage-reports/ \
            --dependency-dir dependency-analysis/ \
            --architecture-dir architecture-validation/ \
            --documentation-dir documentation-quality/ \
            --output quality-gate-report.json

      - name: Generate quality gate summary
        run: |
          cat > quality-gate-summary.md << 'EOF'
          # Quality Gate Evaluation

          ## Summary
          - **Code Quality**: ${{ needs.quality-metrics.result }}
          - **Test Coverage**: ${{ needs.coverage-validation.result }}
          - **Dependency Analysis**: ${{ needs.dependency-analysis.result }}
          - **Architecture Validation**: ${{ needs.architecture-validation.result }}
          - **Documentation Quality**: ${{ needs.documentation-quality.result }}

          ## Quality Gate Status
          <!-- Will be populated by the evaluation script -->
          EOF

          # Append evaluation results
          python scripts/format_quality_gate_summary.py || true

      - name: Upload quality gate report
        uses: actions/upload-artifact@v3
        with:
          name: quality-gate-report
          path: |
            quality-gate-summary.md
            quality-gate-report.json

      - name: Set quality gate status
        if: failure()
        uses: actions/github-script@v6
        with:
          script: |
            // Add failing status check
            github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state: 'failure',
              target_url: 'https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}',
              description: 'Quality gates failed',
              context: 'quality-gates'
            })

      - name: Approve quality gate
        if: success()
        uses: actions/github-script@v6
        with:
          script: |
            // Add passing status check
            github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state: 'success',
              target_url: 'https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}',
              description: 'All quality gates passed',
              context: 'quality-gates'
            })

  # Pull Request Quality Report
  pr-quality-report:
    runs-on: ubuntu-latest
    needs: [quality-gate-evaluation]
    if: always() && github.event_name == 'pull_request'
    steps:
      - name: Download quality gate report
        uses: actions/download-artifact@v3
        with:
          name: quality-gate-report

      - name: Comment on PR
        uses: actions/github-script@v6
        with:
          script: |
            const fs = require('fs');
            const report = fs.readFileSync('quality-gate-summary.md', 'utf8');

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `## 🔍 Code Quality Report\n\n${report}`
            });
