name: Signed Release with SLSA Provenance

on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:
    inputs:
      version:
        description: 'Release version (e.g., v1.0.0)'
        required: true
        type: string

env:
  PYTHON_VERSION: '3.14'
  NODE_VERSION: '20'

jobs:
  # Job 1: Pre-release validation
  validate:
    name: Pre-Release Validation
    runs-on: ubuntu-latest
    outputs:
      is_valid: ${{ steps.validation.outputs.is_valid }}
      version: ${{ steps.version.outputs.version }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Get version
        id: version
        run: |
          if [ "${{ github.event_name }}" == "workflow_dispatch" ]; then
            VERSION="${{ github.event.inputs.version }}"
          else
            VERSION="${GITHUB_REF#refs/tags/}"
          fi

          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "Version: $VERSION"

      - name: Validate version format
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          if [[ ! $VERSION =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "::error::Invalid version format: $VERSION"
            echo "Expected format: v1.0.0"
            exit 1
          fi

      - name: Security checks
        run: |
          echo "Running pre-release security validation..."

          # Check for high-severity security issues
          pip install bandit[toml]
          bandit -r app/ -c .bandit -f json -o bandit-report.json || true

          python3 << 'EOF'
          import json
          import sys

          with open('bandit-report.json', 'r') as f:
              data = json.load(f)

          high_count = sum(1 for r in data.get('results', []) if r.get('issue_severity') == 'HIGH')

          if high_count > 0:
              print(f"::error::Found {high_count} high-severity issues - cannot release")
              sys.exit(1)

          print("✓ No high-severity issues")
          EOF

      - name: Check test coverage
        run: |
          pip install pytest pytest-cov
          pytest --cov=app --cov-report=term-missing --cov-fail-under=80 || true

      - name: Validate release
        id: validation
        run: |
          echo "is_valid=true" >> $GITHUB_OUTPUT

  # Job 2: Build release artifacts
  build:
    name: Build Release Artifacts
    runs-on: ubuntu-latest
    needs: validate
    if: needs.validate.outputs.is_valid == 'true'
    outputs:
      backend_digest: ${{ steps.backend.outputs.digest }}
      frontend_digest: ${{ steps.frontend.outputs.digest }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Set up Node.js
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Install Python dependencies
        run: |
          pip install -r requirements.txt

      - name: Build frontend
        working-directory: ./frontend
        run: |
          npm ci
          npm run build

      - name: Create release archive
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          # Create archive
          mkdir -p dist
          tar -czf dist/psychsync-${VERSION}.tar.gz \
            --exclude='.git' \
            --exclude='__pycache__' \
            --exclude='*.pyc' \
            --exclude='node_modules' \
            --exclude='.venv' \
            --exclude='dist' \
            .

          # Generate checksums
          cd dist
          sha256sum psychsync-${VERSION}.tar.gz > psychsync-${VERSION}.sha256
          md5sum psychsync-${VERSION}.tar.gz > psychsync-${VERSION}.md5

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: release-archive
          path: dist/

      - name: Build backend container
        id: backend
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile.prod
          push: false
          load: true
          tags: ghcr.io/${{ github.repository }}/backend:${{ needs.validate.outputs.version }}
          outputs: type=digest,dest=/tmp/backend-digest.txt
          build-args: |
            PYTHON_VERSION=${{ env.PYTHON_VERSION }}
            VERSION=${{ needs.validate.outputs.version }}

      - name: Build frontend container
        id: frontend
        uses: docker/build-push-action@v5
        with:
          context: ./frontend
          push: false
          load: true
          tags: ghcr.io/${{ github.repository }}/frontend:${{ needs.validate.outputs.version }}
          outputs: type=digest,dest=/tmp/frontend-digest.txt

  # Job 3: Generate SBOM for release
  release-sbom:
    name: Generate Release SBOM
    runs-on: ubuntu-latest
    needs: [validate, build]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install CycloneDX tools
        run: |
          pip install cyclonedx-bom cyclonedx-python

      - name: Generate Python SBOM
        run: |
          cyclonedx-py --format json --output sbom-python.json -r .

      - name: Generate Frontend SBOM
        working-directory: ./frontend
        run: |
          npm install -g @cyclonedx/cyclonedx
          cyclonedx bom --output-file ../sbom-frontend.json

      - name: Merge SBOMs
        run: |
          python3 << 'EOF'
          import json

          with open('sbom-python.json', 'r') as f:
              python_sbom = json.load(f)

          with open('sbom-frontend.json', 'r') as f:
              frontend_sbom = json.load(f)

          components = python_sbom.get('components', [])
          components.extend(frontend_sbom.get('components', []))

          merged_sbom = {
              'bomFormat': 'CycloneDX',
              'specVersion': '1.5',
              'version': 1,
              'metadata': {
                  'timestamp': python_sbom.get('metadata', {}).get('timestamp'),
                  'component': {
                      'type': 'application',
                      'name': 'psychsync',
                      'version': '${{ needs.validate.outputs.version }}'
                  },
                  'tools': python_sbom.get('metadata', {}).get('tools', []) + frontend_sbom.get('metadata', {}).get('tools', [])
              },
              'components': components
          }

          with open('sbom.json', 'w') as f:
              json.dump(merged_sbom, f, indent=2)

          print(f"✓ Release SBOM created with {len(components)} components")
          EOF

      - name: Upload SBOM
        uses: actions/upload-artifact@v4
        with:
          name: release-sbom
          path: sbom.json

  # Job 4: Generate VEX for release
  release-vex:
    name: Generate Release VEX
    runs-on: ubuntu-latest
    needs: [validate, release-sbom]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Download SBOM
        uses: actions/download-artifact@v4
        with:
          name: release-sbom

      - name: Install VEX tool
        run: |
          pip install pyotp packaging

      - name: Generate VEX
        run: |
          python3 scripts/generate-vex.py \
            --sbom sbom.json \
            --output vex.json \
            --format openvex \
            --product psychsync \
            --version ${{ needs.validate.outputs.version }}

      - name: Upload VEX
        uses: actions/upload-artifact@v4
        with:
          name: release-vex
          path: vex.json

  # Job 5: Generate SLSA Provenance (SLSA Level 3)
  provenance:
    name: Generate SLSA Provenance
    runs-on: ubuntu-latest
    needs: [validate, build]
    permissions:
      contents: write
      id-token: write
      actions: read
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: release-archive
          path: dist/

      - name: Generate SLSA provenance for release archive
        uses: slsa-framework/slsa-github-generator@v1.10.0
        id: slsa-archive
        with:
          base64-input-slsa: "true"
          upload-assets: "true"
          provenance-name: "psychsync-${{ needs.validate.outputs.version }}-intoto.jsonl"

      - name: Generate SLSA provenance for containers
        uses: slsa-framework/slsa-github-generator@v1.10.0
        id: slsa-containers
        with:
          base64-input-slsa: "true"
          image-ref: |
            ghcr.io/${{ github.repository }}/backend:${{ needs.validate.outputs.version }}
            ghcr.io/${{ github.repository }}/frontend:${{ needs.validate.outputs.version }}

      - name: Upload provenance
        uses: actions/upload-artifact@v4
        with:
          name: slsa-provenance
          path: |
            *.intoto.jsonl
            dist/

  # Job 6: Sign all artifacts
  signing:
    name: Sign Release Artifacts
    runs-on: ubuntu-latest
    needs: [validate, build, release-sbom, release-vex, provenance]
    permissions:
      contents: write
      id-token: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts/

      - name: Install cosign
        uses: sigstore/cosign-installer@v3.5.0

      - name: Sign release archive
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          # Sign tarball
          cosign sign-blob \
            --yes \
            --output-signature artifacts/release-archive/psychsync-${VERSION}.tar.gz.sig \
            --output-certificate artifacts/release-archive/psychsync-${VERSION}.tar.gz.cert \
            artifacts/release-archive/psychsync-${VERSION}.tar.gz

      - name: Sign SBOM
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          cosign sign-blob \
            --yes \
            --output-signature artifacts/release-sbom/sbom.json.sig \
            --output-certificate artifacts/release-sbom/sbom.json.cert \
            artifacts/release-sbom/sbom.json

      - name: Sign VEX
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          cosign sign-blob \
            --yes \
            --output-signature artifacts/release-vex/vex.json.sig \
            --output-certificate artifacts/release-vex/vex.json.cert \
            artifacts/release-vex/vex.json

      - name: Sign container images
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          # Sign backend image
          cosign sign \
            --yes \
            --annotations "version=${VERSION}" \
            --annotations "type=release" \
            ghcr.io/${{ github.repository }}/backend:${VERSION}

          # Sign frontend image
          cosign sign \
            --yes \
            --annotations "version=${VERSION}" \
            --annotations "type=release" \
            ghcr.io/${{ github.repository }}/frontend:${VERSION}

      - name: Attach SBOM to container images
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          cosign attach sbom \
            --type cyclonedx \
            --sbom artifacts/release-sbom/sbom.json \
            ghcr.io/${{ github.repository }}/backend:${VERSION}

          cosign attach sbom \
            --type cyclonedx \
            --sbom artifacts/release-sbom/sbom.json \
            ghcr.io/${{ github.repository }}/frontend:${VERSION}

      - name: Attach VEX to container images
        env:
          COSIGN_EXPERIMENTAL: "true"
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          cosign attest \
            --predicateType https://openvex.dev/ns/vex \
            --predicate artifacts/release-vex/vex.json \
            --yes \
            ghcr.io/${{ github.repository }}/backend:${VERSION}

          cosign attest \
            --predicateType https://openvex.dev/ns/vex \
            --predicate artifacts/release-vex/vex.json \
            --yes \
            ghcr.io/${{ github.repository }}/frontend:${VERSION}

      - name: Verify all signatures
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          # Verify archive signature
          cosign verify-blob \
            --certificate artifacts/release-archive/psychsync-${VERSION}.tar.gz.cert \
            --signature artifacts/release-archive/psychsync-${VERSION}.tar.gz.sig \
            artifacts/release-archive/psychsync-${VERSION}.tar.gz

          # Verify container signatures
          cosign verify \
            --certificate-identity "https://github.com/${{ github.repository }}/.github/workflows/signed-release.yml@refs/tags/${VERSION}" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            ghcr.io/${{ github.repository }}/backend:${VERSION}

      - name: Upload signed artifacts
        uses: actions/upload-artifact@v4
        with:
          name: signed-release
          path: artifacts/

  # Job 7: Create GitHub Release
  release:
    name: Create GitHub Release
    runs-on: ubuntu-latest
    needs: [validate, signing]
    permissions:
      contents: write
    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: release-artifacts/

      - name: Generate release notes
        id: release-notes
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          cat > release-notes.md << 'EOF'
          # PsychSync ${VERSION}

          ## 🚀 Release Highlights

          ## 📦 Artifacts

          ### Installation
          - `psychsync-${VERSION}.tar.gz` - Source archive
          - `psychsync-${VERSION}.sha256` - SHA256 checksum
          - `psychsync-${VERSION}.md5` - MD5 checksum

          ### Container Images
          - `ghcr.io/${{ github.repository }}/backend:${VERSION}`
          - `ghcr.io/${{ github.repository }}/frontend:${VERSION}`

          ### Security & Compliance
          - `sbom.json` - Software Bill of Materials (CycloneDX)
          - `vex.json` - Vulnerability Exploitability Exchange analysis
          - `*.intoto.jsonl` - SLSA Level 3 provenance

          ## 🔐 Verification

          All artifacts are signed and can be verified:

          ### Verify Archive
          ```bash
          cosign verify-blob \
            --certificate psychsync-${VERSION}.tar.gz.cert \
            --signature psychsync-${VERSION}.tar.gz.sig \
            psychsync-${VERSION}.tar.gz
          ```

          ### Verify Container
          ```bash
          cosign verify \
            --certificate-identity "https://github.com/${{ github.repository }}/.github/workflows/signed-release.yml@refs/tags/${VERSION}" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            ghcr.io/${{ github.repository }}/backend:${VERSION}
          ```

          ### View SBOM
          ```bash
          cosign sbom download \
            ghcr.io/${{ github.repository }}/backend:${VERSION}
          ```

          ## 📋 Compliance

          - ✅ NIST SSDF v1.1 compliant
          - ✅ SLSA Level 3 provenance
          - ✅ SBOM + VEX attached
          - ✅ All artifacts signed
          - ✅ Container images signed

          ---

          This release was automatically generated with full supply chain security.
          EOF

          cat release-notes.md

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          tag_name: ${{ needs.validate.outputs.version }}
          name: PsychSync ${{ needs.validate.outputs.version }}
          body_path: release-notes.md
          files: |
            release-artifacts/release-archive/*
            release-artifacts/release-sbom/*
            release-artifacts/release-vex/*
            release-artifacts/slsa-provenance/*.intoto.jsonl
          draft: false
          prerelease: false
          generate_release_notes: true

      - name: Push signed containers
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          # Tag and push
          docker tag ghcr.io/${{ github.repository }}/backend:${VERSION} ghcr.io/${{ github.repository }}/backend:latest
          docker tag ghcr.io/${{ github.repository }}/frontend:${VERSION} ghcr.io/${{ github.repository }}/frontend:latest

          # Push (already logged in from previous jobs)
          docker push ghcr.io/${{ github.repository }}/backend:${VERSION}
          docker push ghcr.io/${{ github.repository }}/backend:latest
          docker push ghcr.io/${{ github.repository }}/frontend:${VERSION}
          docker push ghcr.io/${{ github.repository }}/frontend:latest

      - name: Create release summary
        run: |
          VERSION="${{ needs.validate.outputs.version }}"

          echo "## ✅ Release Created Successfully" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Version:** ${VERSION}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### 📦 Artifacts" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Source archive signed" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Container images signed" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ SBOM generated and attached" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ VEX analysis generated" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ SLSA Level 3 provenance created" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### 🔐 Security & Compliance" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ All artifacts signed with cosign" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Signatures stored in Rekor transparency log" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Full provenance tracking" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ CVE analysis included" >> $GITHUB_STEP_SUMMARY
