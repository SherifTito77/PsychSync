name: Performance Testing and Monitoring

on:
  schedule:
    # Weekly performance tests on Sundays at 4 AM UTC
    - cron: '0 4 * * 0'
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      test_duration:
        description: 'Duration of load test (seconds)'
        required: true
        default: '300'
        type: string
      user_count:
        description: 'Number of concurrent users'
        required: true
        default: '100'
        type: string

env:
  PYTHON_VERSION: '3.12'
  TEST_DURATION: ${{ github.event.inputs.test_duration || '300' }}
  USER_COUNT: ${{ github.event.inputs.user_count || '100' }}

jobs:
  # Performance Benchmarks
  performance-benchmarks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest-benchmark py-spy memory-profiler
          pip install locust

      - name: Run application benchmarks
        run: |
          # Start application in background
          python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &
          APP_PID=$!
          sleep 15

          # Wait for app to be ready
          timeout 30 bash -c 'until curl -f http://localhost:8000/health; do sleep 1; done'

          # Run performance benchmarks
          pytest --benchmark-only --benchmark-sort=mean tests/performance/ || true

          # Cleanup
          kill $APP_PID || true

      - name: Memory profiling
        run: |
          echo "Running memory profiling..."
          python -m memory_profiler scripts/profile_memory_usage.py || true

      - name: CPU profiling
        run: |
          echo "Running CPU profiling..."
          python -c "
          import time
          import cProfile
          import pstats
          import io
          from app.main import app

          profiler = cProfile.Profile()
          profiler.enable()

          # Simulate some load
          time.sleep(5)

          profiler.disable()
          s = io.StringIO()
          ps = pstats.Stats(profiler, stream=s).sort_stats('cumulative')
          ps.print_stats()

          with open('cpu-profile.txt', 'w') as f:
              f.write(s.getvalue())
          " || true

      - name: Upload benchmark results
        uses: actions/upload-artifact@v3
        with:
          name: performance-benchmarks
          path: |
            .benchmarks/
            cpu-profile.txt
            memory-profile.log

  # Load Testing with Locust
  load-testing:
    runs-on: ubuntu-latest
    needs: performance-benchmarks
    if: github.event_name == 'workflow_dispatch' || github.event_name == 'schedule'
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: psychsync_perf
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      redis:
        image: redis:7
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install locust
          pip install matplotlib seaborn pandas

      - name: Wait for services
        run: |
          sleep 10
          pg_isready -h localhost -p 5432
          redis-cli -h localhost -p 6379 ping

      - name: Setup test database
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/psychsync_perf
          REDIS_URL: redis://localhost:6379
        run: |
          alembic upgrade head
          python scripts/generate_test_data.py --scale medium

      - name: Start application
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/psychsync_perf
          REDIS_URL: redis://localhost:6379
          ENVIRONMENT: testing
        run: |
          python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &
          APP_PID=$!
          echo $APP_PID > app.pid
          sleep 15

      - name: Wait for application
        run: |
          timeout 60 bash -c 'until curl -f http://localhost:8000/api/v1/health; do sleep 2; done'

      - name: Run Locust load test
        run: |
          locust --headless \
            --users ${{ env.USER_COUNT }} \
            --spawn-rate 10 \
            --run-time ${{ env.TEST_DURATION }}s \
            --host http://localhost:8000 \
            -f locustfile.py \
            --html locust-report.html \
            --csv load-test-results

      - name: Generate performance graphs
        run: |
          python scripts/generate_performance_graphs.py || true

      - name: Cleanup
        if: always()
        run: |
          if [ -f app.pid ]; then
            kill $(cat app.pid) || true
            rm app.pid
          fi

      - name: Upload load test results
        uses: actions/upload-artifact@v3
        with:
          name: load-test-results
          path: |
            locust-report.html
            load-test-results_*
            performance_graphs/

  # Database Performance Testing
  database-performance:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: psychsync_db_perf
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install sqlalchemy-utils psycopg2-binary

      - name: Run database performance tests
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/psychsync_db_perf
        run: |
          # Setup database
          alembic upgrade head

          # Run database benchmarking
          python scripts/database_performance_test.py \
            --host localhost \
            --port 5432 \
            --database psychsync_db_perf \
            --user postgres \
            --password postgres

      - name: Analyze query performance
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/psychsync_db_perf
        run: |
          python scripts/analyze_query_performance.py || true

      - name: Upload database performance results
        uses: actions/upload-artifact@v3
        with:
          name: database-performance
          path: |
            db_performance_report.json
            query_analysis.json

  # Frontend Performance Testing
  frontend-performance:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        working-directory: ./frontend
        run: npm ci

      - name: Install Lighthouse CI
        working-directory: ./frontend
        run: npm install -g @lhci/cli@0.12.x

      - name: Build application
        working-directory: ./frontend
        run: npm run build

      - name: Start application in background
        working-directory: ./frontend
        run: |
          npm run preview &
          APP_PID=$!
          echo $APP_PID > app.pid
          sleep 15

      - name: Wait for frontend
        run: |
          timeout 30 bash -c 'until curl -f http://localhost:4173; do sleep 1; done'

      - name: Run Lighthouse CI
        working-directory: ./frontend
        run: |
          lhci autorun \
            --config=.lighthouserc.json \
            --collect.url=http://localhost:4173 \
            --collect.url=http://localhost:4173/login \
            --collect.url=http://localhost:4173/dashboard

      - name: Cleanup
        if: always()
        run: |
          if [ -f frontend/app.pid ]; then
            kill $(cat frontend/app.pid) || true
            rm frontend/app.pid
          fi

      - name: Upload Lighthouse results
        uses: actions/upload-artifact@v3
        with:
          name: lighthouse-performance
          path: |
            frontend/.lighthouseci/

  # Performance Regression Analysis
  performance-regression:
    runs-on: ubuntu-latest
    needs: [performance-benchmarks, load-testing]
    if: always() && (needs.performance-benchmarks.result == 'success' || needs.load-testing.result == 'success')
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Download benchmark artifacts
        uses: actions/download-artifact@v3
        with:
          name: performance-benchmarks
          path: benchmarks/

      - name: Download load test artifacts
        uses: actions/download-artifact@v3
        with:
          name: load-test-results
          path: load-tests/

      - name: Analyze performance regression
        run: |
          python scripts/analyze_performance_regression.py \
            --benchmark-dir benchmarks/ \
            --load-test-dir load-tests/ \
            --output performance-regression-report.json || true

      - name: Generate performance summary
        run: |
          cat > performance-summary.md << 'EOF'
          # Performance Test Summary

          ## Test Results
          - **Benchmark Tests**: ${{ needs.performance-benchmarks.result }}
          - **Load Testing**: ${{ needs.load-testing.result }}

          ## Key Metrics

          ### Response Times
          - Average: TBD (extracted from load test results)
          - 95th percentile: TBD
          - 99th percentile: TBD

          ### Throughput
          - Requests per second: TBD

          ### Error Rate
          - Success rate: TBD%

          EOF

      - name: Upload performance summary
        uses: actions/upload-artifact@v3
        with:
          name: performance-summary
          path: |
            performance-summary.md
            performance-regression-report.json

      - name: Create performance issue on regression
        if: failure()
        uses: actions/github-script@v6
        with:
          script: |
            github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: '⚡ Performance Regression Detected',
              body: 'Automated performance tests detected a regression. Please review the performance reports for details.',
              labels: ['performance', 'regression', 'automated']
            })

  # Performance Notifications
  performance-notifications:
    runs-on: ubuntu-latest
    needs: [performance-regression]
    if: always()
    steps:
      - name: Notify on performance issues
        if: contains(needs.*.result, 'failure')
        run: |
          echo "⚡ Performance issues detected! Review the performance test reports."
          # Add performance monitoring webhook here

      - name: Notify on successful performance tests
        if: needs.performance-regression.result == 'success'
        run: |
          echo "✅ Performance tests completed successfully!"