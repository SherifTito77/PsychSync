name: Secret Detection and Prevention

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]
  workflow_dispatch:

jobs:
  gitleaks-scan:
    name: Gitleaks Secret Scanning
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for accurate scanning

      - name: Gitleaks Scan
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}  # Optional: For additional config
        with:
          args: --verbose --redact --config .gitleaks.toml

      - name: Upload Gitleaks Report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: gitleaks-report
          path: gitleaks-report.json

  trufflehog-scan:
    name: Trufflehog Deep Scan
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Trufflehog
        uses: trufflesecurity/trufflehog@main
        with:
          path: ./
          base: ${{ github.event.repository.default_branch }}
          head: HEAD
          extra_args: --only-verified --json

      - name: Upload Trufflehog Report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: trufflehog-report
          path: trufflehog-report.json

  check-secrets-in-diff:
    name: Check Secrets in PR Diff
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout PR
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check for secrets in diff
        uses: trufflesecurity/trufflehog@main
        with:
          path: ./
          base: ${{ github.base_ref }}
          head: HEAD
          extra_args: --diff --only-verified

  secret-scan-summary:
    name: Secret Scan Summary
    runs-on: ubuntu-latest
    needs: [gitleaks-scan, trufflehog-scan]
    if: always()

    steps:
      - name: Download scan reports
        uses: actions/download-artifact@v4
        with:
          path: scan-reports

      - name: Generate summary
        run: |
          echo "# Secret Detection Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "## Gitleaks Scan" >> $GITHUB_STEP_SUMMARY
          if [ -f scan-reports/gitleaks-report/gitleaks-report.json ]; then
            echo "✅ Scan completed" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ No report found (may have passed)" >> $GITHUB_STEP_SUMMARY
          fi
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "## Trufflehog Scan" >> $GITHUB_STEP_SUMMARY
          if [ -f scan-reports/trufflehog-report/trufflehog-report.json ]; then
            echo "✅ Scan completed" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ No report found (may have passed)" >> $GITHUB_STEP_SUMMARY
          fi

  block-commits-with-secrets:
    name: Block Commits with Secrets
    if: github.event_name == 'push'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Scan with Gitleaks (blocking)
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          args: --no-banner --redact

      - name: Block on findings
        if: failure()
        run: |
          echo "::error::Secrets detected in code! Commit blocked."
          echo "Please remove the secrets before committing:"
          echo "1. Check the gitleaks report for details"
          echo "2. Remove/secrets from code"
          echo "3. Commit again"
          exit 1
