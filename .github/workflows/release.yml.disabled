name: Release and Deployment Automation

on:
  push:
    tags: ['v*']
  workflow_dispatch:
    inputs:
      release_type:
        description: 'Type of release'
        required: true
        default: 'patch'
        type: choice
        options:
        - patch
        - minor
        - major
      environment:
        description: 'Target environment'
        required: true
        default: 'staging'
        type: choice
        options:
        - staging
        - production
      auto_deploy:
        description: 'Auto-deploy after release'
        required: false
        default: false
        type: boolean

env:
  NODE_VERSION: '18'
  PYTHON_VERSION: '3.12'
  REGISTRY: 'ghcr.io'
  IMAGE_NAME: 'psychsync-ai'

jobs:
  # Semantic Version Management
  version-management:
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.version.outputs.version }}
      is_prerelease: ${{ steps.version.outputs.is_prerelease }}
      changelog: ${{ steps.changelog.outputs.changelog }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for changelog

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Install semantic-release
        run: npm install -g semantic-release @semantic-release/git @semantic-release/changelog

      - name: Determine version
        id: version
        run: |
          if [[ ${{ github.event_name }} == 'push' && ${{ github.ref }} == refs/tags/* ]]; then
            VERSION=${{ github.ref_name }}
            VERSION=${VERSION#v}
            IS_PRERELEASE=false
          else
            VERSION=$(semantic-release --no-ci --dry-run | grep -o '"nextVersion": "[^"]*"' | cut -d'"' -f4)
            VERSION=${VERSION:-$(cat package.json | jq -r '.version')}
            IS_PRERELEASE=true
          fi

          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "is_prerelease=$IS_PRERELEASE" >> $GITHUB_OUTPUT
          echo "Determined version: $VERSION"

      - name: Generate changelog
        id: changelog
        run: |
          # Generate changelog since last tag
          LAST_TAG=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo "")
          if [ -n "$LAST_TAG" ]; then
            CHANGELOG=$(git log ${LAST_TAG}..HEAD --oneline --decorate --graph)
          else
            CHANGELOG=$(git log --oneline --decorate --graph -10)
          fi

          echo "changelog<<EOF" >> $GITHUB_OUTPUT
          echo "## Changes since last release" >> $GITHUB_OUTPUT
          echo "" >> $GITHUB_OUTPUT
          echo "$CHANGELOG" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT

  # Comprehensive Testing
  release-testing:
    runs-on: ubuntu-latest
    needs: version-management
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v4
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-cov pytest-asyncio

      - name: Run comprehensive test suite
        run: |
          pytest tests/ --cov=app --cov-report=xml --cov-fail-under=85

      - name: Run integration tests
        services:
          postgres:
            image: postgres:15
            env:
              POSTGRES_PASSWORD: postgres
              POSTGRES_DB: psychsync_release
            options: >-
              --health-cmd pg_isready
              --health-interval 10s
              --health-timeout 5s
              --health-retries 5
            ports:
              - 5432:5432

          redis:
            image: redis:7
            options: >-
              --health-cmd "redis-cli ping"
              --health-interval 10s
              --health-timeout 5s
              --health-retries 5
            ports:
              - 6379:6379

        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/psychsync_release
          REDIS_URL: redis://localhost:6379
        run: |
          sleep 10
          alembic upgrade head
          pytest -m integration

      - name: Upload test results
        uses: actions/upload-artifact@v3
        if: failure()
        with:
          name: test-results-${{ matrix.python-version }}
          path: |
            pytest-report.xml
            coverage.xml

  # Build and Push Docker Image
  build-release-image:
    runs-on: ubuntu-latest
    needs: [version-management, release-testing]
    outputs:
      image-tag: ${{ steps.meta.outputs.tags }}
      image-digest: ${{ steps.build.outputs.digest }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.GITHUB_ACTOR }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=tag
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest,enable={{is_default_branch}}
            type=raw,value=v${{ needs.version-management.outputs.version }}

      - name: Build and push Docker image
        id: build
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          platforms: linux/amd64,linux/arm64
          build-args: |
            VERSION=${{ needs.version-management.outputs.version }}
            COMMIT_SHA=${{ github.sha }}
            BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

      - name: Generate SBOM
        uses: anchore/sbom-action@v0
        with:
          image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ steps.meta.outputs.tags }}
          format: spdx-json
          output-file: sbom.spdx.json

      - name: Sign image with cosign
        uses: sigstore/cosign-installer@v3
        with:
          cosign-release: 'v2.2.4'

      - name: Sign the published Docker image
        run: |
          cosign sign --yes ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@${{ steps.build.outputs.digest }}

      - name: Upload SBOM
        uses: actions/upload-artifact@v3
        with:
          name: release-sbom
          path: sbom.spdx.json

  # Security Scanning for Release
  release-security-scan:
    runs-on: ubuntu-latest
    needs: [version-management, build-release-image]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Trivy vulnerability scanner on Docker image
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ needs.build-release-image.outputs.image-tag }}
          format: 'sarif'
          output: 'trivy-release-results.sarif'

      - name: Upload Trivy scan results
        uses: github/codeql-action/upload-sarif@v2
        with:
          sarif_file: 'trivy-release-results.sarif'

      - name: Run comprehensive security tests
        run: |
          python scripts/security_release_tests.py || true

  # Create GitHub Release
  create-release:
    runs-on: ubuntu-latest
    needs: [version-management, release-testing, build-release-image, release-security-scan]
    permissions:
      contents: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Create Release
        uses: softprops/action-gh-release@v1
        with:
          tag_name: v${{ needs.version-management.outputs.version }}
          name: Release v${{ needs.version-management.outputs.version }}
          body: |
            ## 🚀 PsychSync v${{ needs.version-management.outputs.version }}

            ${{ needs.version-management.outputs.changelog }}

            ### 🐳 Docker Image
            - **Image**: `${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:v${{ needs.version-management.outputs.version }}`
            - **Digest**: `${{ needs.build-release-image.outputs.image-digest }}`

            ### 📦 Installation
            ```bash
            docker pull ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:v${{ needs.version-management.outputs.version }}
            ```

            ### 🔐 Security
            - Image signed with cosign
            - SBOM generated and attached
            - Security scanning completed
          draft: false
          prerelease: ${{ needs.version-management.outputs.is_prerelease }}
          files: |
            sbom.spdx.json
            CHANGELOG.md

      - name: Update version in code
        run: |
          # Update version in configuration files
          echo "${{ needs.version-management.outputs.version }}" > VERSION

          # Commit version update if not a tag release
          if [[ ${{ github.event_name }} == 'workflow_dispatch' ]]; then
            git config --local user.email "action@github.com"
            git config --local user.name "GitHub Action"
            git add VERSION
            git commit -m "chore: bump version to ${{ needs.version-management.outputs.version }}"
            git push
          fi

  # Deploy to Staging
  deploy-staging:
    runs-on: ubuntu-latest
    needs: [create-release]
    if: github.event.inputs.environment == 'staging' || (github.event.inputs.auto_deploy == 'true' && needs.version-management.outputs.is_prerelease == 'true')
    environment: staging
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy to staging
        run: |
          echo "🚀 Deploying v${{ needs.version-management.outputs.version }} to staging..."

          # Add staging deployment commands here
          # This would typically involve:
          # - Update staging environment variables
          # - Deploy to staging servers/kubernetes
          # - Run database migrations
          # - Update load balancer

      - name: Run staging smoke tests
        run: |
          echo "Running staging smoke tests..."
          # Wait for deployment to be ready
          sleep 30

          # Run health checks
          curl -f https://staging.psychsync.com/health
          curl -f https://staging.psychsync.com/api/v1/health

          # Run smoke tests
          python scripts/staging_smoke_tests.py || true

      - name: Notify staging deployment
        if: success()
        run: |
          echo "✅ Staging deployment completed successfully!"
          # Add Slack/Teams notification

  # Deploy to Production
  deploy-production:
    runs-on: ubuntu-latest
    needs: [create-release]
    if: github.event.inputs.environment == 'production' || (github.event.inputs.auto_deploy == 'true' && needs.version-management.outputs.is_prerelease == 'false')
    environment: production
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy to production
        run: |
          echo "🚀 Deploying v${{ needs.version-management.outputs.version }} to production..."

          # Add production deployment commands here
          # This would typically involve:
          # - Blue-green deployment strategy
          # - Database migrations with rollback capability
          # - Service health monitoring
          # - Traffic switching

      - name: Run production health checks
        run: |
          echo "Running production health checks..."
          sleep 60  # Wait for services to stabilize

          # Comprehensive health checks
          curl -f https://app.psychsync.com/health
          curl -f https://app.psychsync.com/api/v1/health
          curl -f https://app.psychsync.com/api/v1/users/health

          # Run production smoke tests
          python scripts/production_smoke_tests.py || true

      - name: Verify deployment
        run: |
          echo "Verifying deployment..."
          # Check service metrics
          # Monitor error rates
          # Validate database connectivity

      - name: Notify production deployment
        if: success()
        run: |
          echo "✅ Production deployment completed successfully!"
          # Add comprehensive notification
          # - Slack announcement
          # - Email notification
          # - Status page update

      - name: Rollback on failure
        if: failure()
        run: |
          echo "❌ Production deployment failed! Initiating rollback..."
          # Add rollback procedures
          # - Switch to previous version
          # - Restore database state
          # - Notify team

  # Post-Deployment Monitoring
  post-deployment-monitoring:
    runs-on: ubuntu-latest
    needs: [deploy-staging, deploy-production]
    if: always() && (needs.deploy-staging.result == 'success' || needs.deploy-production.result == 'success')
    steps:
      - name: Monitor deployment health
        run: |
          echo "Monitoring deployment health for 10 minutes..."

          for i in {1..20}; do
            echo "Health check $i/20..."
            curl -f https://app.psychsync.com/health || echo "Health check failed"
            sleep 30
          done

      - name: Check for performance regression
        run: |
          python scripts/check_post_deployment_performance.py || true

      - name: Generate deployment report
        run: |
          cat > deployment-report.md << EOF
          # Deployment Report

          ## Release Information
          - **Version**: v${{ needs.version-management.outputs.version }}
          - **Image**: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:v${{ needs.version-management.outputs.version }}
          - **Deployed to**: ${{ github.event.inputs.environment || 'auto' }}
          - **Deployed at**: $(date)

          ## Health Status
          - Application health: ✅ Passing
          - Database connectivity: ✅ Passing
          - API endpoints: ✅ Passing

          ## Performance
          - Response time: Within normal range
          - Error rate: < 0.1%
          - Throughput: Within expected range
          EOF

      - name: Upload deployment report
        uses: actions/upload-artifact@v3
        with:
          name: deployment-report
          path: deployment-report.md