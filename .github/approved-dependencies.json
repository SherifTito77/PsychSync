  "policies": {
    "new_dependencies": {
      "require_approval": true,
      "approval_required_from": ["security-lead", "tech-lead"],
      "justification_required": true,
      "risk_assessment_required": true,
      "alternatives_considered": true
    },
    "vulnerability_response": {
      "critical": {
        "sla": "24_hours",
        "action": "remediate",
        "deployment_blocked": true
      },
      "high": {
        "sla": "72_hours",
        "action": "remediate_or_explain",
        "deployment_blocked": true
      },
      "medium": {
        "sla": "30_days",
        "action": "schedule_fix",
        "deployment_blocked": false
      },
      "low": {
        "sla": "90_days",
        "action": "monitor",
        "deployment_blocked": false
      }
    },
    "exemptions": {
      "max_duration": "90_days",
      "require_business_justification": true,
      "require_mitigation_plan": true,
      "require_cto_approval": true,
      "auto_expire": true
    }
  },
  "vex_rules": {
    "auto_not_affected": [
      {
        "condition": "cvss_score < 4.0",
        "justification": "protected_at_runtime_perimeter",
        "impact": "Low severity, monitoring in place"
      },
      {
        "condition": "component_not_imported",
        "justification": "component_not_present",
        "impact": "Vulnerable code not included in build"
      },
      {
        "condition": "has_waf_protection",
        "justification": "protected_by_mitigating_control",
        "impact": "WAF rules prevent exploitation"
      }
    ],
    "require_manual_review": [
      {
        "condition": "cvss_score >= 7.0",
        "reviewer": "security-lead",
        "justification_required": true
      },
      {
        "condition": "authentication_or_authorization",
        "reviewer": "security-lead",
        "justification_required": true
      },
      {
        "condition": "data_access",
        "reviewer": "security-lead",
        "justification_required": true
      }
    ]
  }
