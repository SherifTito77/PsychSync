{
  "dashboard": {
    "id": null,
    "title": "PsychSync Stripe Billing",
    "tags": ["psychsync", "stripe", "billing", "revenue"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Revenue per Minute",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "psychsync:stripe:revenue_per_minute:5m",
            "legendFormat": "$/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "green", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Payment Success Rate",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "expr": "psychsync:stripe:payment_success_rate:5m * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 85},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Active Subscriptions",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "targets": [
          {
            "expr": "psychsync:stripe:active_subscriptions:5m",
            "legendFormat": "Active"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "MRR (Monthly Recurring Revenue)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "psychsync:stripe:mrr:5m",
            "legendFormat": "MRR"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 1000},
                {"color": "green", "value": 5000}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Webhook Processing Rate",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "psychsync:stripe:webhook_processing_rate:5m",
            "legendFormat": "Webhooks/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Revenue Over Time",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "psychsync:stripe:revenue_per_minute:5m",
            "legendFormat": "Revenue $/min"
          }
        ],
        "yAxes": [
          {
            "label": "Revenue ($/min)",
            "min": 0
          }
        ]
      },
      {
        "id": 7,
        "title": "Payment Success Rate Over Time",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "psychsync:stripe:payment_success_rate:5m * 100",
            "legendFormat": "Success %"
          }
        ],
        "yAxes": [
          {
            "label": "Success %",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 8,
        "title": "Stripe API Success Rate",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "psychsync:stripe:success_rate:5m * 100",
            "legendFormat": "API Success %"
          }
        ],
        "yAxes": [
          {
            "label": "Success %",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 9,
        "title": "Payment Failures by Type",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "rate(stripe_payments_failed_total[5m])",
            "legendFormat": "{{failure_type}}"
          }
        ],
        "yAxes": [
          {
            "label": "Failures/min",
            "min": 0
          }
        ]
      },
      {
        "id": 10,
        "title": "Stripe API Response Time",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "targets": [
          {
            "expr": "psychsync:stripe:average_response_time:5m",
            "legendFormat": "Response Time (s)"
          }
        ],
        "yAxes": [
          {
            "label": "Response Time (s)",
            "min": 0
          }
        ]
      },
      {
        "id": 11,
        "title": "Webhook Processing Time",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(stripe_webhook_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Processing Time"
          },
          {
            "expr": "histogram_quantile(0.99, rate(stripe_webhook_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P99 Processing Time"
          }
        ],
        "yAxes": [
          {
            "label": "Processing Time (s)",
            "min": 0
          }
        ]
      },
      {
        "id": 12,
        "title": "Revenue by Plan",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 40
        },
        "targets": [
          {
            "expr": "sum by (plan_type) (rate(stripe_revenue_cents_total[5m])) / 100",
            "legendFormat": "{{plan_type}}"
          }
        ]
      },
      {
        "id": 13,
        "title": "Daily Revenue",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 48
        },
        "targets": [
          {
            "expr": "psychsync:stripe:revenue_per_hour:5m * 24",
            "legendFormat": "Daily Revenue"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 500},
                {"color": "green", "value": 2000}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "Churn Rate (Daily)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 48
        },
        "targets": [
          {
            "expr": "psychsync:business:subscription_churn_rate_daily:5m * 100",
            "legendFormat": "Churn %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 2},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m"
  }
}
