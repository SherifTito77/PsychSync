{
  "name": "PsychSync - Personality Assessment Platform",
  "short_name": "PsychSync",
  "description": "Mobile-first personality assessments with offline capabilities and intelligent insights",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#3b82f6",
  "background_color": "#ffffff",
  "lang": "en",
  "categories": [
    "productivity",
    "health",
    "education"
  ],
  "icons": [
    {
      "src": "/assets/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/maskable-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icons/monochrome-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshots/mobile-assessment-1.png",
      "sizes": "375x812",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile personality assessment in progress"
    },
    {
      "src": "/assets/screenshots/desktop-dashboard-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop assessment dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick Assessment",
      "short_name": "Quick Test",
      "description": "Start a quick personality assessment",
      "url": "/assessments/quick",
      "icons": [
        {
          "src": "/assets/icons/quick-assessment.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Team Dashboard",
      "short_name": "Teams",
      "description": "View team assessment results",
      "url": "/dashboard/teams",
      "icons": [
        {
          "src": "/assets/icons/teams.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Personal Insights",
      "short_name": "Insights",
      "description": "View your personality insights",
      "url": "/insights/personal",
      "icons": [
        {
          "src": "/assets/icons/insights.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+psychsync",
      "url": "/handle-protocol?type=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import-assessment",
      "accept": {
        "application/json": [
          ".json",
          ".psychsync"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/share-assessment",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "assessment",
          "accept": [
            "application/json",
            ".psychsync"
          ]
        }
      ]
    }
  }
}